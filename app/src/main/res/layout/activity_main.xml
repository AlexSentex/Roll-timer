<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱ Таймери рулонів"
            android:textColor="@color/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/settingsButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorOnSurface"
            android:textSize="20sp"
            android:text="⚙" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#9AA1AC"
        android:visibility="gone"
        android:text="Ще немає жодного таймера.\nНатисніть «+ Додати таймер» знизу." />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/dashboardList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>

    <Button
        android:id="@+id/addButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="+ Додати таймер"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="#FFFFFF" />

</LinearLayout>        android:padding="24dp"
        android:textColor="#9AA1AC"
        android:visibility="gone"
        android:text="Ще немає жодного таймера.\nНатисніть «+ Додати таймер» знизу." />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/dashboardList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>

    <Button
        android:id="@+id/addButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="+ Додати таймер"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="#FFFFFF" />

</LinearLayout>                    android:id="@+id/wakeStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/colorOnSurface"
                    android:text="💡 Екран вимкнеться сам" />
                <Button
                    android:id="@+id/wakeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Не вимикати екран" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <TextView
                    android:id="@+id/notifStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/colorOnSurface"
                    android:text="🔔 Сповіщення вимкнено" />
                <Button
                    android:id="@+id/notifButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Дозволити" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/exactAlarmStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/colorOnSurface"
                    android:text="⏰ Точні будильники не дозволені" />
                <Button
                    android:id="@+id/exactAlarmButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Дозволити" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/timerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>

    <Button
        android:id="@+id/addButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="+ Додати таймер"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="#FFFFFF" />

</LinearLayout>
